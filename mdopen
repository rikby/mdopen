#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: mdopen FILE.md\n' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

input_arg=$1

if [ ! -f "$input_arg" ]; then
  printf 'mdopen: file not found: %s\n' "$input_arg" >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  printf 'mdopen: bun is not on PATH\n' >&2
  exit 1
fi

input_dir=$(cd -- "$(dirname -- "$input_arg")" && pwd)
input_file=$(basename -- "$input_arg")
input="$input_dir/$input_file"
title=${input_file%.*}

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir=$(cd -- "$(dirname -- "$source_path")" && pwd)
  source_path=$(readlink -- "$source_path")
  case $source_path in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done
script_dir=$(cd -- "$(dirname -- "$source_path")" && pwd)

outdir="${TMPDIR:-/tmp}/mdopen"
mkdir -p "$outdir"

css="$outdir/mdopen.css"
overrides_css="$outdir/mdopen-overrides.css"
template="$script_dir/templates/mdopen.html"
out="$outdir/${title}.html"

cp "$script_dir/assets/mdopen.css" "$css"
cp "$script_dir/assets/mdopen-overrides.css" "$overrides_css"
cp "$script_dir/assets/styles/demo.css" "$outdir/demo.css"
cp "$script_dir/assets/styles/readthedocs.css" "$outdir/readthedocs.css"
mkdir -p "$outdir/fonts"
cp "$script_dir"/assets/styles/fonts/* "$outdir/fonts/"

default_style="default"
case "$input" in
  "$script_dir"/review/*) default_style="demo" ;;
esac

bun "$script_dir/renderer.js" "$input" "$template" "$out" "$title" "$(basename -- "$css")" "$default_style"

open "$out"
printf '%s\n' "$out"
