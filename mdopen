cat > "$template" <<'HTML'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>$pagetitle$</title>
  <link id="mdopen-theme" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.8.1/github-markdown-light.min.css">
  <link rel="stylesheet" href="$css$">
  <style>
$highlighting-css$
  </style>
</head>
<body>
  <nav class="mdopen-toolbar" aria-label="Theme">
    <button type="button" data-theme="light" aria-pressed="true">Light</button>
    <button type="button" data-theme="dark" aria-pressed="false">Dark</button>
    <span class="mdopen-divider" aria-hidden="true"></span>
    <button type="button" data-print="gray" aria-pressed="true">Gray</button>
    <button type="button" data-print="blue" aria-pressed="false">Blue</button>
    <button type="button" data-print="burgundy" aria-pressed="false">Burg</button>
    <span class="mdopen-divider" aria-hidden="true"></span>
    <button type="button" data-density="normal" aria-pressed="true">Gap</button>
    <button type="button" data-density="tight" aria-pressed="false">-1</button>
    <button type="button" data-density="dense" aria-pressed="false">-2</button>
    <button type="button" data-density="compact" aria-pressed="false">-3</button>
  </nav>
  <article class="markdown-body">
$body$
  </article>
  <script>
    (function () {
      var styles = {
        light: 'https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.8.1/github-markdown-light.min.css',
        dark: 'https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.8.1/github-markdown-dark.min.css'
      };
      var link = document.getElementById('mdopen-theme');
      var themeButtons = Array.prototype.slice.call(document.querySelectorAll('[data-theme]'));
      var printButtons = Array.prototype.slice.call(document.querySelectorAll('[data-print]'));
      var densityButtons = Array.prototype.slice.call(document.querySelectorAll('[data-density]'));

      function setTheme(theme) {
        if (!styles[theme]) theme = 'light';
        document.documentElement.dataset.mdopenTheme = theme;
        link.href = styles[theme];
        localStorage.setItem('mdopen-theme', theme);
        themeButtons.forEach(function (button) {
          button.setAttribute('aria-pressed', String(button.dataset.theme === theme));
        });
      }

      function setDensity(density) {
        if (['normal', 'tight', 'dense', 'compact'].indexOf(density) === -1) density = 'normal';
        document.documentElement.dataset.mdopenDensity = density;
        localStorage.setItem('mdopen-density', density);
        densityButtons.forEach(function (button) {
          button.setAttribute('aria-pressed', String(button.dataset.density === density));
        });
      }

      function setPrintTheme(printTheme) {
        if (['gray', 'blue', 'burgundy'].indexOf(printTheme) === -1) printTheme = 'gray';
        document.documentElement.dataset.mdopenPrint = printTheme;
        localStorage.setItem('mdopen-print', printTheme);
        printButtons.forEach(function (button) {
          button.setAttribute('aria-pressed', String(button.dataset.print === printTheme));
        });
      }

      themeButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          setTheme(button.dataset.theme);
        });
      });

      densityButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          setDensity(button.dataset.density);
        });
      });

      printButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          setPrintTheme(button.dataset.print);
        });
      });

      var params = new URLSearchParams(window.location.search);
      setTheme(params.get('theme') || localStorage.getItem('mdopen-theme') || 'light');
      setPrintTheme(params.get('print') || localStorage.getItem('mdopen-print') || 'gray');
      setDensity(params.get('density') || localStorage.getItem('mdopen-density') || 'normal');

      var themeBeforePrint = null;
      window.addEventListener('beforeprint', function () {
        themeBeforePrint = localStorage.getItem('mdopen-theme') || 'light';
        link.href = styles.light;
        document.documentElement.dataset.mdopenTheme = 'light';
      });
      window.addEventListener('afterprint', function () {
        setTheme(themeBeforePrint || localStorage.getItem('mdopen-theme') || 'light');
      });
    }());
  </script>
</body>
</html>
