#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: mdopen FILE.md\n' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

input_arg=$1

if [ ! -f "$input_arg" ]; then
  printf 'mdopen: file not found: %s\n' "$input_arg" >&2
  exit 1
fi

if ! command -v pandoc >/dev/null 2>&1; then
  printf 'mdopen: pandoc is not on PATH\n' >&2
  exit 1
fi

input_dir=$(cd -- "$(dirname -- "$input_arg")" && pwd)
input_file=$(basename -- "$input_arg")
input="$input_dir/$input_file"
title=${input_file%.*}

outdir="${TMPDIR:-/tmp}/mdopen"
mkdir -p "$outdir"

css="$outdir/mdopen.css"
template="$outdir/mdopen-template.html"
out="$outdir/${title}.html"

