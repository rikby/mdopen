{
  "name": "mdopen",
  "version": "1.0.0",
  "description": "Quickly render a Markdown file as styled HTML and open it in the browser.",
  "main": "renderer.js",
  "bin": {
    "mdopen": "./bin/mdopen.js"
  },
  "scripts": {
    "check": "bun -e \"process.env.MDOPEN_NO_OPEN='1'; process.argv=['bun','bin/mdopen.js','README.md']; require('./bin/mdopen.js');\"",
    "build:binary": "bun scripts/build-binary.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
